<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pxreprise</AssemblyName>
    <RootNamespace>PXReprise</RootNamespace>
    <Version>0.4.10</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- MetaMorpheus 1.1.12's own pin (2026-10-07, PXReprise D28): the engine and the search read with one mzLib again.
         MetaMorpheus still runs as its own process, so a later difference would be safe, never shared in one process. -->
    <PackageReference Include="mzLib" Version="1.0.594" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PXReprise.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The profiles ship beside the executable: `pxreprise` reads them from there unless the profiles option says otherwise. -->
    <None Include="..\..\profiles\*.toml" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\profiles\lists\*" Link="profiles\lists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
