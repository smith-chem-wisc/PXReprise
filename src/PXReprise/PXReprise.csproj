<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pxreprise</AssemblyName>
    <RootNamespace>PXReprise</RootNamespace>
    <Version>0.4.32</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.0.595 (v0.4.32): one ahead of MetaMorpheus 1.1.12's 1.0.594, for the library cleaning's CleavageBlockingPolicy
         (cleavageRules PXR-V8). MetaMorpheus runs as its own process, so the difference is never shared in one process.
         Rejoin MetaMorpheus's pin at its next release. -->
    <PackageReference Include="mzLib" Version="1.0.595" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PXReprise.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The profiles ship beside the executable: `pxreprise` reads them from there unless the profiles option says otherwise. -->
    <None Include="..\..\profiles\*.toml" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\profiles\lists\*" Link="profiles\lists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
