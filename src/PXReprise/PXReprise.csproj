<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pxreprise</AssemblyName>
    <RootNamespace>PXReprise</RootNamespace>
    <!-- The release version, for the engine and datarepo alike (decision 0073): datarepo has none of its own. A release's
         pull request bumps it; the release workflow checks it against the release tag and stamps it on both programs. -->
    <Version>0.4.50</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.0.600 (D84, the user, 2026-11-21: "lets make sure pxreprise and (dataRepo) inside it are using the most recent
         mzLib"): two ahead of MetaMorpheus 1.1.15's 1.0.598, and the version datarepo's projects here use. MetaMorpheus
         runs as its own process, so the difference is never shared in one process. Rejoin MetaMorpheus's pin when its
         release takes 1.0.600 or later. -->
    <PackageReference Include="mzLib" Version="1.0.600" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2026-11-11: the spectral library chains shared through a folder or S3. The store layer is its own project
         since 2026-11-13, shared with `datarepo push` / `pull`. -->
    <ProjectReference Include="..\PXReprise.Storage\PXReprise.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PXReprise.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The profiles ship beside the executable: `pxreprise` reads them from there unless the profiles option says otherwise. -->
    <None Include="..\..\profiles\*.toml" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\profiles\lists\*" Link="profiles\lists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
