<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pxreprise</AssemblyName>
    <RootNamespace>PXReprise</RootNamespace>
    <!-- The release version, for the engine and datarepo alike (decision 0073): datarepo has none of its own. A release's
         pull request bumps it; the release workflow checks it against the release tag and stamps it on both programs. -->
    <Version>1.0.0</Version>
    <!-- mzLib's FlashLFQ depends on Microsoft.ML, whose build targets refuse an executable built for any processor but
         x64 and x86. So the engine could not be published for osx-arm64, one of the release's four platforms (decision
         0073). The engine never runs FlashLFQ's engine or any Microsoft.ML code: MetaMorpheus quantifies, as its own
         process, and the engine only reads FlashLFQ's types (the differential stage's SpectraFileInfo and tables). Across
         the offline tests no Microsoft.ML assembly is ever loaded (2026-11-25). So the check is switched off here. Code
         that runs a Microsoft.ML trainer in the engine would need native libraries no arm64 build ships. -->
    <EnableMLUnsupportedPlatformTargetCheck>false</EnableMLUnsupportedPlatformTargetCheck>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.0.601 (the user, 2026-11-24: "we will also update the mzLib nuget in pxreprise"): the same mzLib as the
         MetaMorpheus release that follows 1.1.15 (MetaMorpheus #2997), and the version datarepo's projects here use.
         Was 1.0.600 (D84), two ahead of MetaMorpheus 1.1.15's 1.0.598; MetaMorpheus runs as its own process, so a
         difference is never shared in one process. -->
    <PackageReference Include="mzLib" Version="1.0.601" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2026-11-11: the spectral library chains shared through a folder or S3. The store layer is its own project
         since 2026-11-13, shared with `datarepo push` / `pull`. -->
    <ProjectReference Include="..\PXReprise.Storage\PXReprise.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PXReprise.Tests" />
    <InternalsVisibleTo Include="PXReprise.Seam.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The profiles ship beside the executable: `pxreprise` reads them from there unless the profiles option says otherwise. -->
    <None Include="..\..\profiles\*.toml" Link="profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\profiles\lists\*" Link="profiles\lists\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
