<Project>
  <!--
    datarepo has no version of its own (decision 0073). One PXReprise release holds the engine and datarepo under one
    version, whose single source is src/PXReprise/PXReprise.csproj's <Version>: the release workflow checks it against the
    tag and stamps it on both programs (-p:Version=X.Y.Z). Here it is `0.0.0-dev`, which every other build keeps: a build
    that is not a release must never look like one. The version is recorded in each bundle's `ingester.version`, hashed
    into every catalog id (catalog_id carries the package version, as the Python one did), and written as the site's
    generator, so every release, even one that changes only the engine, gives a new catalog id.
  -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!--
    The commit a release was built from (CI passes -p:SourceRevisionId=<sha>). `datarepo run` records it as the
    install's identity and refuses a build without one, because an engine artefact stamped by unidentifiable code
    is reproducible by nobody (aging 063).
  -->
  <ItemGroup Condition="'$(SourceRevisionId)' != ''">
    <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" />
  </ItemGroup>
</Project>
